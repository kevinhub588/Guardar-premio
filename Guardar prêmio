local function frozenCamera()
	local c = workspace.CurrentCamera
	if not c then return function() end end
	local ot = c.CameraType
	local fr = c.CFrame
	pcall(function() c.CameraType = Enum.CameraType.Scriptable c.CFrame = fr end)
	return function() pcall(function() c.CameraType = ot end) end
end

local fpsGen = 0
local function fpsOn()
	if typeof(setfpscap) ~= "function" then return end
	fpsGen += 1
	local mine = fpsGen
	task.spawn(function()
		local hi = true
		local st = os.clock()
		while fpsGen == mine and os.clock() - st < 60 do
			pcall(setfpscap, hi and FPS[1] or FPS[2])
			hi = not hi
			task.wait(FPS[3])
		end
	end)
end
local function fpsOff()
	fpsGen += 1
	if typeof(setfpscap) == "function" then pcall(setfpscap, 240) end
end

