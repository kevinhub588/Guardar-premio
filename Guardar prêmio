local hasFileAPI = (typeof(writefile) == "function" and typeof(readfile) == "function")
local function saveKey(k)
	if hasFileAPI then pcall(function() writefile(KEY_CONFIG.SAVE_FILE, tostring(k)) end) end
end
local function loadKey()
	if not hasFileAPI then return nil end
	local ok, data = pcall(function() return readfile(KEY_CONFIG.SAVE_FILE) end)
	if ok and data and #data > 0 then return tostring(data) end
	return nil
end

local function getHWID()
	if typeof(gethwid) == "function" then
		local ok, r = pcall(gethwid)
		if ok and r then return tostring(r) end
	end
	if typeof(get_hwid) == "function" then
		local ok, r = pcall(get_hwid)
		if ok and r then return tostring(r) end
	end
	return nil
end

local function fetchKeyList()
	local ok, res = pcall(function() return game:HttpGet(KEY_CONFIG.KEY_LIST_URL, true) end)
	if not ok or not res then return {} end

	local list = {}
	for key in res:gmatch("(CRK%-[A-Z0-9]+%-[A-Z0-9]+%-[A-Z0-9]+)") do
		list[key] = true
	end
	return list
end

local function validateKey(inputKey)
	inputKey = tostring(inputKey or ""):gsub("%s", "")
	if #inputKey < 4 then return false, "Digite uma key válida" end

	if inputKey == KEY_CONFIG.ADMIN_KEY then
		return true, "Admin", true
	end

	local keys = fetchKeyList()
	local count = 0
	local exists = false
	for k, _ in pairs(keys) do
		count = count + 1
		if k == inputKey then exists = true end
	end

	if count > KEY_CONFIG.MAX_KEYS then
		return false, "Limite excedido"
	end

	if not exists then
		return false, "Key inválida"
	end

	if KEY_CONFIG.HWID_LOCK then
		local savedHwid = nil
		local saved = loadKey()
		if saved and saved:find("|") then
			local k, h = saved:match("^([^|]+)|(.+)$")
			if k == inputKey then savedHwid = h end
		end
		if savedHwid and getHWID() and savedHwid ~= getHWID() then
			return false, "Key travada em outro dispositivo"
		end
	end

	return true, "OK", false
end

local function saveKeyWithHwid(k)
	local hwid = getHWID() or ""
	saveKey(k .. "|" .. hwid)
end

