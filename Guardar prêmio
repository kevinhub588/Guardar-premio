local function shieldUnlink()
	for _, l in ipairs(shield.Links) do pcall(function() l:Disconnect() end) end
	table.clear(shield.Links)
end

local gStates = {
	[Enum.HumanoidStateType.Running] = true,
	[Enum.HumanoidStateType.RunningNoPhysics] = true,
	[Enum.HumanoidStateType.Landed] = true,
}

local function grounded(h)
	if not h or h.Health <= 0 or h.FloorMaterial == Enum.Material.Air then return false end
	return gStates[h:GetState()] == true
end

local function shieldSwap()
	local ch = localPlayer.Character
	local h = ch and ch:FindFirstChildOfClass("Humanoid")
	if not h or h.Health <= 0 then return end
	if shield.Clone and shield.Clone.Parent == ch then return end
	if not grounded(h) then return end
	local cl = h:Clone()
	h.Parent = nil
	cl.Parent = ch
	workspace.CurrentCamera.CameraSubject = cl
	shieldControls(cl)
	shieldAnimate(ch)
	shield.Original = h
	shield.Clone = cl
	table.insert(shield.Links, h:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
		if cl.Parent ~= nil then cl.WalkSpeed = h.WalkSpeed end
	end))
	local a1 = h:FindFirstChildOfClass("Animator")
	local a2 = cl:FindFirstChildOfClass("Animator")
	if a1 and a2 then
		table.insert(shield.Links, a1.AnimationPlayed:Connect(function(p)
			local anim = p.Animation
			if not anim or cl.Parent == nil then return end
			local ok, tk = pcall(function() return a2:LoadAnimation(anim) end)
			if not ok or not tk then return end
			pcall(function()
				tk.Priority = p.Priority tk.Looped = p.Looped
				tk:Play(0.05, math.max(p.WeightTarget, 0.01), p.Speed)
			end)
			local st
			st = p.Stopped:Connect(function() st:Disconnect() pcall(function() tk:Stop(0.1) end) end)
		end))
	end
	table.insert(shield.Links, cl.Died:Connect(function()
		shieldUnlink()
		shield.Original, shield.Clone = nil, nil
		local cur = localPlayer.Character
		if cur and h.Parent == nil then
			h.Parent = cur
			workspace.CurrentCamera.CameraSubject = h
			shieldControls(h)
		end
		pcall(function() cl:Destroy() end)
		h.Health = 0
	end))
end

local function shieldUndo()
	shieldUnlink()
	local ch = localPlayer.Character
	local o, cl = shield.Original, shield.Clone
	shield.Original, shield.Clone = nil, nil
	if o and cl and ch and o.Parent == nil and cl.Parent == ch then
		o.Parent = ch
		workspace.CurrentCamera.CameraSubject = o
		shieldControls(o)
		pcall(function() cl:Destroy() end)
		shieldAnimate(ch)
	end
end

local function shieldStart()
	shieldSwap()
	local n = 0
	shield.Connection = RunService.Heartbeat:Connect(function(dt)
		n += dt
		local ch = localPlayer.Character
		local missing = not (shield.Clone and ch and shield.Clone.Parent == ch)
		if (missing and 0.25 or 3) <= n then n = 0 shieldSwap() end
	end)
	shield.Added = localPlayer.CharacterAdded:Connect(function(ch)
		shieldUnlink()
		shield.Original, shield.Clone = nil, nil
		task.spawn(function()
			ch:WaitForChild("Humanoid", 10)
			task.wait(1)
			if shield.Connection and localPlayer.Character == ch then shieldSwap() end
		end)
	end)
end

local function shieldStop()
	if shield.Connection then shield.Connection:Disconnect() shield.Connection = nil end
	if shield.Added then shield.Added:Disconnect() shield.Added = nil end
	shieldUndo()
end

