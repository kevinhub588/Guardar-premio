local indexScanAt = 0
local function indexTick()
	if not INDEX.Running then return end
	if os.clock() - indexScanAt < 1 then return end
	indexScanAt = os.clock()
	local seen = {}
	local count = 0
	local rp = root()

	local currentArea = nil
	if INDEX_ESP_MODE == "Atual" and rp then
		local snap = snapshot()
		local closest, minDist = nil, math.huge
		for _, rec in ipairs(snap) do
			local d = (rec.BottomCFrame.Position - rp.Position).Magnitude
			if d < minDist then minDist = d closest = rec end
		end
		if closest then currentArea = tostring(closest.AreaId or "Field") end
	end

	for _, r in ipairs(snapshot()) do
		if count >= MAX_INDEX_BOARDS then break end
		local areaId = tostring(r.AreaId or "Field")
		if INDEX_ESP_MODE == "Atual" and currentArea and areaId ~= currentArea then continue end
		local info = describe(r)
		if passFilter(info) and r.BottomCFrame then
			seen[info.Uid] = true
			count += 1
			local board = INDEX.Boards[info.Uid]
			if not board then
				board = makeIndexBoard(info.Uid)
				INDEX.Boards[info.Uid] = board
			end
			board.billboard.Enabled = true
			board.host.CFrame = CFrame.new(r.BottomCFrame.Position + Vector3.new(0, 2.5, 0))
			local iconUrl = info.PetIcon
			if iconUrl == "" then iconUrl = info.EggIcon end
			if iconUrl ~= "" then
				board.icon.Visible = true
				board.icon.Image = iconUrl
			else board.icon.Visible = false end
			board.name.Text = info.Name
			local dist = rp and (rp.Position - r.BottomCFrame.Position).Magnitude or 0
			board.rarity.Text = "[" .. FILTER.RarityNames[info.Rarity + 1]:gsub("%+$", "") .. "] "
				.. formatDist(dist)
		end
	end

	for uid, board in pairs(INDEX.Boards) do
		if not seen[uid] then
			destroyIndexBoard(board)
			INDEX.Boards[uid] = nil
		end
	end
end

local function startIndexESP()
	if INDEX.Running then return end
	INDEX.Running = true
	INDEX.Token += 1
	local tk = INDEX.Token
	task.spawn(function()
		while INDEX.Running and tk == INDEX.Token do
			pcall(indexTick)
			task.wait(0.5)
		end
	end)
end

local function stopIndexESP()
	INDEX.Running = false
	INDEX.Token += 1
	for uid, board in pairs(INDEX.Boards) do
		destroyIndexBoard(board)
	end
	table.clear(INDEX.Boards)
	if indexGui then pcall(function() indexGui:Destroy() end) indexGui = nil end
end

