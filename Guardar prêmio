local function parseValue(text)
	text = tostring(text or ""):lower():gsub("%s", "")
	local num, suffix = text:match("^([%d%.]+)([kmbt]?)$")
	num = tonumber(num)
	if not num then return nil end
	local mult = ({ k = 1e3, m = 1e6, b = 1e9, t = 1e12 })[suffix] or 1
	return math.floor(num * mult)
end

local function passFilter(info)
	if FILTER.Mode == "Value" then return info.Value >= FILTER.MinValue end
	if FILTER.Mode == "Rarity" then return info.Rarity >= FILTER.MinRarity end
	return true
end

