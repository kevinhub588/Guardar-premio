	if ESP.Running then return end
	ESP.Running = true
	ESP.Token += 1
	local tk = ESP.Token
	task.spawn(function()
		while ESP.Running and tk == ESP.Token do
			pcall(espTick)
			task.wait(0.5)
		end
	end)
end

local function stopESP()
	ESP.Running = false
	ESP.Token += 1
	destroyESP()
end

