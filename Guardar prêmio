					ColorSequenceKeypoint.new(0.40, cfg.main),
					ColorSequenceKeypoint.new(0.60, cfg.glow),
					ColorSequenceKeypoint.new(0.80, cfg.main),
					ColorSequenceKeypoint.new(1.00, cfg.glow),
				})
			end
			rot = (rot + 6) % 360
			t = t + 0.1
			local pulse = base + (math.sin(t) * 0.5 + 0.5) * 2.0 - 0.5
			s.Thickness = pulse
			g.Rotation = rot
			task.wait(0.03)
