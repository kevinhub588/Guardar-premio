			ColorSequenceKeypoint.new(0.20, CONFIG.RedGlow),
			ColorSequenceKeypoint.new(0.40, CONFIG.Red),
			ColorSequenceKeypoint.new(0.60, CONFIG.RedSoft),
			ColorSequenceKeypoint.new(0.80, CONFIG.Red),
			ColorSequenceKeypoint.new(1.00, CONFIG.RedGlow),
		}),
		Rotation = 0,
	})
	g.Parent = s
	task.spawn(function()
		local rot = 0
		local t = 0
		local hue = 0
		local base = baseThickness or 3
		while s.Parent do
			if NEON_MODE == "RGB" then
				hue = (hue + 0.005) % 1
				local c1 = Color3.fromHSV(hue, 1, 1)
				local c2 = Color3.fromHSV((hue + 0.15) % 1, 1, 1)
				g.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0.00, c1),
					ColorSequenceKeypoint.new(0.25, c2),
					ColorSequenceKeypoint.new(0.50, c1),
