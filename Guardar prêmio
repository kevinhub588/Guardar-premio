local function makeSection(parent, title, order)
	local sec = make("Frame", {
		Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = CONFIG.Bg3,
		BorderSizePixel = 0, AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order or 0, ZIndex = 3, Parent = parent,
	})
	corner(sec, 8)
	stroke(sec, CONFIG.Border, 1)
	padding(sec, 10)
	make("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1,
		Font = Enum.Font.Code, TextSize = 11, TextColor3 = CONFIG.RedSoft,
		TextXAlignment = Enum.TextXAlignment.Left, Text = "▸ " .. title,
		ZIndex = 4, Parent = sec,
	})
	local body = make("Frame", {
		Size = UDim2.new(1, 0, 0, 0), Position = UDim2.fromOffset(0, 22),
		BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 4, Parent = sec,
	})
	make("UIListLayout", {
		Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = body,
	})
	return body
end

local function makePage(name, title)
	local page = make("Frame", {
		Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y, Visible = false,
		ZIndex = 3, Parent = scrollList,
	})
	make("UIListLayout", {
		Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = page,
	})
	PAGES[name] = { frame = page, title = title }
	return page
end

local function showPage(name)
	for n, p in pairs(PAGES) do p.frame.Visible = (n == name) end
	local p = PAGES[name]
	if p then headerTitleLbl.Text = "> " .. string.upper(p.title) end
	for _, btn in ipairs(menuFrame:GetChildren()) do
		if btn:IsA("TextButton") then
			local active = btn:GetAttribute("PageName") == name
			local s = btn:FindFirstChildOfClass("UIStroke")
			local indicator = btn:FindFirstChild("Frame")
			if active then
				TweenService:Create(btn, TweenInfo.new(0.2), {
					BackgroundColor3 = CONFIG.Red,
					TextColor3 = Color3.fromRGB(255, 255, 255),
				}):Play()
				if s then s.Color = CONFIG.RedGlow s.Thickness = 1.5 end
				if indicator then indicator.Visible = true end
			else
				TweenService:Create(btn, TweenInfo.new(0.2), {
					BackgroundColor3 = CONFIG.Bg4,
					TextColor3 = CONFIG.Text,
				}):Play()
				if s then s.Color = CONFIG.Border s.Thickness = 1 end
				if indicator then indicator.Visible = false end
			end
		end
	end
end

local function makeMenuButton(name, label, icon, order)
	local btn = make("TextButton", {
		Size = UDim2.new(1, 0, 0, 32),
		BackgroundColor3 = CONFIG.Bg4, BackgroundTransparency = 0,
		BorderSizePixel = 0, Font = Enum.Font.Code, TextSize = 11,
		TextColor3 = CONFIG.Text, TextXAlignment = Enum.TextXAlignment.Left,
		Text = "  " .. icon .. "  " .. tostring(label),
		AutoButtonColor = false, LayoutOrder = order,
		ZIndex = 4, Parent = menuFrame,
	})
	corner(btn, 6)
	stroke(btn, CONFIG.Border, 1)
	local indicator = make("Frame", {
		Size = UDim2.new(0, 3, 0, 18), Position = UDim2.new(0, 3, 0.5, -9),
		BackgroundColor3 = CONFIG.Red, BorderSizePixel = 0,
		Visible = false, ZIndex = 5, Parent = btn,
	})
	corner(indicator, 2)
	btn:SetAttribute("PageName", name)
	btn.MouseButton1Click:Connect(function() showPage(name) end)
	btn.MouseEnter:Connect(function()
		if btn.BackgroundColor3 ~= CONFIG.Red then
			TweenService:Create(btn, TweenInfo.new(0.2), {
				BackgroundColor3 = CONFIG.BgHover,
				TextColor3 = CONFIG.RedSoft,
			}):Play()
		end
	end)
	btn.MouseLeave:Connect(function()
		if btn.BackgroundColor3 ~= CONFIG.Red then
			TweenService:Create(btn, TweenInfo.new(0.2), {
				BackgroundColor3 = CONFIG.Bg4,
				TextColor3 = CONFIG.Text,
			}):Play()
		end
	end)
	return btn
end

