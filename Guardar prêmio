	local w = workspace:FindFirstChild("World") or workspace:FindFirstChild("__OBJECTS")
	w = w and w:FindFirstChild("Areas")
	w = w and w:FindFirstChild("SeparationLine")
	local ok = w and w:IsA("BasePart")
