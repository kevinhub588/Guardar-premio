local function snapshot()
	local list = {}
	local rf = remote("RF/EggWorld/AskFieldEggSnapshot")
	if not rf then return list end
	local ok, res = pcall(function() return rf:InvokeServer() end)
	local recs = ok and type(res) == "table" and res.Records or nil
	if type(recs) ~= "table" then return list end
	for _, r in pairs(recs) do
		if type(r) == "table"
			and type(r.Uid) == "string"
			and (r.State == "Slot" or r.State == "Dropped")
			and typeof(r.BottomCFrame) == "CFrame" then
			list[#list + 1] = r
		end
	end
	return list
end

local function eggPosition(uid)
	for _, r in ipairs(snapshot()) do
		if r.Uid == uid then return r.BottomCFrame.Position end
	end
	return nil
end

local indexedCache = { Set = {}, At = 0 }
local function getIndexedSet()
	if os.clock() - indexedCache.At < 3 then return indexedCache.Set end
	indexedCache.At = os.clock()
	local set = {}
	pcall(function()
		local Save = SaveModule
		if not Save then
			local ok, r = pcall(function() return require(ReplicatedStorage.Shared.Save) end)
			if ok then Save = r end
		end
		if Save then
			local getter = Save.Peek or Save.Get
			if type(getter) == "function" then
				local ok, sv = pcall(getter)
				if ok and type(sv) == "table" and type(sv.Index) == "table" then
					for k, v in pairs(sv.Index) do
						if v == true then set[tostring(k)] = true end
					end
				end
			end
		end
	end)
	indexedCache.Set = set
	return set
end

local function readInventory()
	local inv = {}
	pcall(function()
		if EggState and type(EggState.ReadOwnerEggs) == "function" then
			local ok, res = pcall(EggState.ReadOwnerEggs, localPlayer.UserId)
			if ok and type(res) == "table" then
				for uid, rec in pairs(res) do
					if type(rec) == "table" then inv[uid] = rec end
				end
			end
		end
	end)
	return inv
end

local function lookupAsset(category)
	if type(Assets) ~= "table" or type(Assets.Directory) ~= "table" then return nil end
	return Assets.Directory[tostring(category)]
end

local function describeRecord(category, record)
	local entry = lookupAsset(category)
	local info = {
		Uid = record.Uid, Category = tostring(category),
		Name = tostring(category), PetIcon = "", EggIcon = "",
		Rarity = 0, Value = 0,
	}
	if type(entry) == "table" then
		info.Name = tostring(entry.DisplayName or category)
		local petIcon = entry.Icon
		if petIcon ~= nil and tostring(petIcon) ~= "" then info.PetIcon = tostring(petIcon) end
		local eggIcon = type(entry.Egg) == "table" and entry.Egg.Icon or nil
		if eggIcon ~= nil and tostring(eggIcon) ~= "" then info.EggIcon = tostring(eggIcon) end
		if type(entry.Rarity) == "table" then
			info.Rarity = tonumber(entry.Rarity.RarityNumber or entry.Rarity.Rank) or 0
		end
		local s = tonumber(record.AssetScale) or 1
		local f = s > 5 and (s / 5) ^ 1.2 * 19.637875755794113 or s ^ 1.85
		local m = 1
		if type(Mutations) == "table" and type(Mutations.EarningsFor) == "function" then
			local okM, rM = pcall(Mutations.EarningsFor,
				type(record.Mutations) == "table" and record.Mutations or {})
			if okM and type(rM) == "number" then m = rM end
		end
		info.Value = (tonumber(entry.EarningRate) or 0) * f * m
	end
	return info
end

local function describe(record)
	return describeRecord(tostring(record.AssetCategory), record)
end

local function formatVal(v)
	if not v or v <= 0 then return "$0/s" end
	local u = { "", "K", "M", "B", "T", "Qa", "Qi" }
	local n, i = v, 1
	while math.abs(n) >= 1000 and i < #u do n = n / 1000 i = i + 1 end
	local s = i == 1 and string.format("%d", math.floor(n)) or string.format("%.1f", n)
	return "$" .. s .. u[i] .. "/s"
end

local function formatDist(n)
	if n >= 1000 then return string.format("%.1fkm", n / 1000) end
	return string.format("%dm", math.floor(n + 0.5))
end

local function formatTime(sec)
	sec = math.floor(sec)
	local h = math.floor(sec / 3600)
	local m = math.floor((sec % 3600) / 60)
	local s = sec % 60
	return string.format("%02d:%02d:%02d", h, m, s)
end

