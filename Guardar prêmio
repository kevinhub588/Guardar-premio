local dangerCache, dangerAt = {}, 0
local function dangers()
	if os.clock() - dangerAt < 1 then return dangerCache end
	dangerAt = os.clock()
	local list = {}
	local function add(inst)
		local ok, cf, sz = pcall(function()
			if inst:IsA("Model") then return inst:GetBoundingBox() end
			if inst:IsA("BasePart") then return inst.CFrame, inst.Size end
		end)
		if ok and cf and sz then
			local half = Vector3.new(math.abs(sz.X), 0, math.abs(sz.Z)) * 0.5
			local rt = (cf - cf.Position):VectorToWorldSpace(half)
			local rx = math.max(math.abs(rt.X), half.X, half.Z)
			local rz = math.max(math.abs(rt.Z), half.X, half.Z)
			list[#list + 1] = {
				MinX = cf.Position.X - rx, MaxX = cf.Position.X + rx,
				MinZ = cf.Position.Z - rz, MaxZ = cf.Position.Z + rz,
			}
		end
	end
	local function bad(name)
		if name == "ScrambleLocalVisuals" or name == "DrScrambleEvent" then return false end
		name = string.lower(name)
		return string.find(name, "portal", 1, true)
			or string.find(name, "teleport", 1, true)
			or string.find(name, "mech", 1, true)
			or string.find(name, "arena", 1, true)
			or string.find(name, "scramble", 1, true)
	end
	for _, ch in ipairs(workspace:GetChildren()) do
		if (ch:IsA("Model") or ch:IsA("BasePart") or ch:IsA("Folder")) and bad(ch.Name) then
			if ch:IsA("Folder") then
				for _, i in ipairs(ch:GetChildren()) do add(i) end
			else add(ch) end
		end
	end
	local bld = workspace:FindFirstChild("World")
	bld = bld and bld:FindFirstChild("Build")
	if bld then
		for _, ch in ipairs(bld:GetChildren()) do
			if bad(ch.Name) then
				for _, i in ipairs(ch:GetChildren()) do add(i) end
			end
		end
	end
	dangerCache = list
	return list
end

local function avoid(from, to)
	for _, d in ipairs(dangers()) do
		local x0, x1, z0, z1 = d.MinX - 12, d.MaxX + 12, d.MinZ - 12, d.MaxZ + 12
		local inside = from.X >= x0 and from.X <= x1 and from.Z >= z0 and from.Z <= z1
		if not inside then
			local t0, t1, hit = 0, 1, true
			for _, ax in ipairs({
				{ from.X, to.X - from.X, x0, x1 },
				{ from.Z, to.Z - from.Z, z0, z1 },
			}) do
				local p, dl, lo, hi = ax[1], ax[2], ax[3], ax[4]
				if math.abs(dl) < 1e-6 then
					if p < lo or p > hi then hit = false end
				else
					local ta, tb = (lo - p) / dl, (hi - p) / dl
					if ta > tb then ta, tb = tb, ta end
					t0, t1 = math.max(t0, ta), math.min(t1, tb)
					if t0 > t1 then hit = false end
				end
			end
			if hit then
				local zL, zH = z0 - 2, z1 + 2
				local z = math.abs(from.Z - zL) <= math.abs(from.Z - zH) and zL or zH
				if z < -440 or z > -290 then z = z == zL and zH or zL end
				local x = math.abs(from.X - x0) <= math.abs(from.X - x1) and x0 or x1
				if math.abs(from.Z - z) < 3 then
					x = math.abs(to.X - x0) <= math.abs(to.X - x1) and x0 or x1
				end
				return Vector3.new(x, to.Y, z)
			end
		end
	end
	return to
end

