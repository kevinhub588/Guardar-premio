local stealClone = nil
local function dropClone()
	local cp = stealClone
	stealClone = nil
	if cp then pcall(function() cp:Destroy() end) end
end

local function postClone()
	dropClone()
	local ch = localPlayer.Character
	if not ch then return end
	local was = ch.Archivable
	ch.Archivable = true
	local cp = ch:Clone()
	ch.Archivable = was
	if cp then
		for _, d in ipairs(cp:GetDescendants()) do
			if d:IsA("LuaSourceContainer") or d:IsA("Humanoid") then
				pcall(function() d:Destroy() end)
			elseif d:IsA("BasePart") then
				d.Anchored = true d.Collide = false
				d.CanTouch = false d.CanQuery = false
			end
		end
		cp.Name = "Clone"
		cp.Parent = workspace
		stealClone = cp
	end
end

local function instantTP(uid)
	local st = os.clock()
	local lineX, lineY = lineInfo()
	local r = root()
	if not r then return false end
	local lz = math.clamp(r.Position.Z, -425, -300)
	local ld = Vector3.new(lineX + CFG.LandOffset, lineY + 3.35, lz)
	local hS = math.max(walkSpeed() * CFG.HopRatio, CFG.HopMin)
	local hY = r.Position.Y + CFG.HopLift
	local x = r.Position.X
	local rt = 0
	local rc = frozenCamera()
	state.ReleaseCamera = rc
	pcall(postClone)
	fpsOn()
	while x - hS > ld.X and not state.Cancel do
		if not state.Carrying then
			if not regrab(uid) then break end
			local cr = root()
			if cr then x = math.min(x, cr.Position.X) end
			continue
		end
		local nx = x - hS
		status(string.format("TP: pulando pra casa, X %d", math.floor(nx)))
		local pb = state.PulledAt
		local hl = 0
		while hl < CFG.HopGap do
			place(Vector3.new(nx, hY, lz))
			hl += RunService.Heartbeat:Wait()
		end
		local ck = root()
		local pl = state.PulledAt > pb or (ck ~= nil and (ck.Position.X - nx > 10 or ck.AssemblyLinearVelocity.Magnitude > 150))
		if pl and state.Carrying and not state.Cancel then
			rt += 1
			CFG.HopGap = math.min(CFG.HopGapMax, CFG.HopGap + 0.02)
			if rt > CFG.HopRetries then break end
			status(string.format("TP: puxado, retry %d/%d", rt, CFG.HopRetries))
			local s = 0
			while s < 0.12 and not state.Cancel do
				place(Vector3.new(x, hY, lz))
				s += RunService.Heartbeat:Wait()
			end
		else
			x = nx
			CFG.HopGap = math.max(CFG.HopGapMin, CFG.HopGap - 0.01)
		end
	end
	status("TP: pousando")
	ld = Vector3.new(ld.X, groundY(ld, ld.Y), ld.Z)
	local function land()
		local cr = root()
		if cr and cr.Position.X <= ld.X + 1 and cr.Position.Y > ld.Y - 25 then
			pcall(function() cr.AssemblyLinearVelocity = Vector3.zero end)
			return
		end
		place(ld)
	end
	land()
	for at = 1, 3 do
		local s = 0
		while s < CFG.LandSettle and not state.Cancel do s += RunService.Heartbeat:Wait() end
		local lnd = root()
		if state.Carrying and lnd and (lnd.Position.X - ld.X > 12 or lnd.Position.Y < ld.Y - 25) then
			status("TP: retry de pouso " .. at)
			land()
		else break end
	end
	dropClone()
	if state.Carrying and not state.Cancel then
		local dl = 0
		while dl < CFG.DropDelay do dl += RunService.Heartbeat:Wait() end
		status("TP: largando o ovo")
		dropEgg()
		local w = 0
		while state.Carrying and w < 1 and not state.Cancel do w += RunService.Heartbeat:Wait() end
		local cr = root()
		if cr then
			pcall(function()
				cr.AssemblyLinearVelocity = Vector3.zero
				cr.AssemblyAngularVelocity = Vector3.zero
			end)
		end
		rc()
		dropClone()
		status("TP: pegando de volta")
		if not grab(uid, 3) and not regrab(uid) then
			fpsOff()
			status("Não conseguiu pegar o ovo")
			return false
		end
		dropClone()
	end
	rc()
	local ok = false
	if state.Carrying then ok = runHome(lineX, lz) end
	fpsOff()
	return ok or state.Delivered >= st
end

local function doStealSync(uid, info)
	if state.Busy then return false end
	state.Busy = true
	state.Cancel = false
	local ok = pcall(function()
		status("Procurando ovo")
		local e = eggPosition(uid)
		if not e then status("Ovo sumiu") return end
		if state.Carrying and state.Uid ~= uid then
			dropEgg()
			local w = 0
			while state.Carrying and w < 1 do w += RunService.Heartbeat:Wait() end
		end
		fpsOn()
		status("Indo até o ovo")
		if not runToEgg(uid, e) then
			fpsOff() status("Não conseguiu chegar") return
		end
		status("Pegando ovo")
		if not grab(uid, 4) then
			fpsOff() status("Ovo resistiu") return
		end
		local delivered = instantTP(uid)
		status(delivered and "Entregue!" or "Falha na entrega")
		if delivered then STATS.Ovos += 1 end
	end)
	fpsOff()
	dropClone()
	if state.ReleaseCamera then pcall(state.ReleaseCamera) state.ReleaseCamera = nil end
	state.Busy = false
	return ok
end

