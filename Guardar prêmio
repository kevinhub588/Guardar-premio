local PLACE = { Running = false, Token = 0, NextTry = 0, FailCount = 0 }
local placeBlacklist = {}

local function ownPlot()
	local p = nil
	pcall(function()
		local ps = workspace:FindFirstChild("Plots")
		if not ps then return end
		for _, pl in ipairs(ps:GetChildren()) do
			local s = pl:FindFirstChild("PlotSign")
			s = s and s:FindFirstChild("PlayerPlotSign")
			s = s and s:FindFirstChild("Frame")
			local n = s and s:FindFirstChild("PlayerName")
			if n and n:IsA("TextLabel") then
				local t = string.lower(n.Text)
				if t == string.lower(localPlayer.Name) or t == string.lower(localPlayer.DisplayName) then
					p = pl break
				end
			end
		end
	end)
	return p
end

local function penAnchor()
	local p = ownPlot()
	if not p then return nil end
	local tu = p:FindFirstChild("ToUpdate")
	local sp = tu and tu:FindFirstChild("StarterPen") or p:FindFirstChild("CenterPoint")
	if not sp then return nil end
	local ok, cf = pcall(function()
		return sp:IsA("Model") and sp:GetPivot() or sp.CFrame
	end)
	return ok and cf.Position or nil
end

local function waitNearAnchor(timeout)
	local an = penAnchor()
	if not an then return false end
	local st = os.clock()
	while os.clock() - st < (timeout or 2) do
		local r = root()
		if r and (r.Position - an).Magnitude < 15 then return true end
		RunService.Heartbeat:Wait()
	end
	return false
end

local function tryPlace(uid)
	if not PLACE.Running then return false end
	local rf = remote("RF/EggWorld/AskPlaceEgg")
	if not rf or not rf:IsA("RemoteFunction") then return false end
	local ch = localPlayer.Character
	local h = ch and ch:FindFirstChildOfClass("Humanoid")
	if h and ch:FindFirstChildWhichIsA("Tool") then
		pcall(function() h:UnequipTools() end)
		task.wait(0.05)
	end
	local w = remote("RF/EggWorld/AskWearTool")
	if w then
		local okW = pcall(function() w:InvokeServer(uid) end)
		if not okW then return false end
	end
	task.wait(0.25)
	if not PLACE.Running then return false end
	local ok, res = pcall(function()
		return rf:InvokeServer({
			Uid = uid,
			LocalCFrame = CFrame.new(math.random(-20, 20), -0.5, math.random(4, 30)),
		})
	end)
	return ok and res ~= false
end

task.spawn(function()
	while true do
		task.wait(30)
		if next(placeBlacklist) ~= nil then placeBlacklist = {} end
	end
end)

local function placeTick()
	if not PLACE.Running then return false end
	if state.Busy or state.Carrying then return false end
	if os.clock() < (PLACE.NextTry or 0) then return false end
	local indexed = getIndexedSet()
	local inv = readInventory()
	local cs = {}
	for uid, rec in pairs(inv) do
		if placeBlacklist[uid] == nil and rec.Placement == nil then
			local cat = tostring(rec.AssetCategory or "")
			if AUTO_PLACE_MODE == "Index" then
				if not indexed[cat] then cs[#cs + 1] = { Uid = uid, Category = cat } end
			else
				local info = describeRecord(cat, rec)
				if passFilter(info) or FILTER.Mode == "Off" then
					cs[#cs + 1] = { Uid = uid, Category = cat }
				end
			end
		end
	end
	if #cs == 0 then
		PLACE.NextTry = os.clock() + 5
		if PLACE.Running then status("Acabaram os ovos") end
		return false
	end
	local an = penAnchor()
	local r = root()
	if an and r and (r.Position - an).Magnitude > 12 then
		place(an + Vector3.new(0, 3, 0))
		waitNearAnchor(2)
	end
	local pl = 0
	for _, e in ipairs(cs) do
		if pl >= 3 then break end
		if not PLACE.Running then break end
		if tryPlace(e.Uid) then
			pl += 1
			PLACE.FailCount = 0
			status("Colocando ovo")
		else
			PLACE.FailCount += 1
			if PLACE.FailCount >= 3 then placeBlacklist[e.Uid] = true end
		end
		task.wait(0.35)
	end
	PLACE.NextTry = os.clock() + 1
	return pl > 0
end

local function startPlace()
	if PLACE.Running then return end
	PLACE.Running = true
	PLACE.Token += 1
	PLACE.NextTry = 0
	PLACE.FailCount = 0
	local tk = PLACE.Token
	task.spawn(function()
		while PLACE.Running and tk == PLACE.Token do
			pcall(placeTick)
			task.wait(0.5)
		end
	end)
end

local function stopPlace()
	PLACE.Running = false
	PLACE.Token += 1
	PLACE.NextTry = 0
	PLACE.FailCount = 0
end

