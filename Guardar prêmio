-- AUTO
-- ============================================================
local AUTO = { Running = false, Token = 0 }

local function pickBest()
	local infos = {}
	for _, r in ipairs(snapshot()) do
		local info = describe(r)
		if passFilter(info) then infos[#infos + 1] = info end
	end
	if #infos == 0 then return nil end
	table.sort(infos, function(a, b)
		if a.Value ~= b.Value then return a.Value > b.Value end
		return a.Rarity > b.Rarity
	end)
	return infos[1]
end

local function pickBestIndex()
	local indexed = getIndexedSet()
	local infos = {}
	for _, r in ipairs(snapshot()) do
		local info = describe(r)
		if not indexed[info.Category] and passFilter(info) then infos[#infos + 1] = info end
	end
	if #infos == 0 then return nil end
	table.sort(infos, function(a, b)
		if a.Value ~= b.Value then return a.Value > b.Value end
		return a.Rarity > b.Rarity
	end)
	return infos[1]
end

local function autoLoop()
	local tk = AUTO.Token
	while AUTO.Running and tk == AUTO.Token do
		if state.Busy then
			task.wait(0.2)
		else
			local best
			if AUTO_STEAL_MODE == "Index" then best = pickBestIndex() else best = pickBest() end
			if not best then
				status(AUTO_STEAL_MODE == "Index" and "Index: sem novos" or "Sem ovos")
				task.wait(1)
			else
				status((AUTO_STEAL_MODE == "Index" and "Index: " or "Auto: ") .. tostring(best.Name))
				doStealSync(best.Uid, best)
				task.wait(0.3)
			end
		end
	end
end

local function startAuto()
	if AUTO.Running then return end
	AUTO.Running = true
	AUTO.Token += 1
	state.Cancel = false
	task.spawn(autoLoop)
end

local function stopAuto()
	AUTO.Running = false
	AUTO.Token += 1
	state.Cancel = true
end

-- ============================================================
-- TREADMILL
-- ============================================================
local TREAD = { Running = false, Token = 0, NextTry = 0, Riding = false, WatcherConn = nil }

local function beltPart()
	local p = ownPlot()
	if not p then return nil end
	local b = p:FindFirstChild("TreadmillBottom")
	if b and b:IsA("BasePart") then return b end
	local u = p:FindFirstChild("TreadmillUpgrade")
	return u and u:FindFirstChildWhichIsA("BasePart") or nil
end

local function onBelt()
	local b = beltPart()
	local r = root()
	if not b or not r then return false end
	local lp = b.CFrame:PointToObjectSpace(r.Position)
	local sx = b.Size.X / 2 + 2.5
	local sz = b.Size.Z / 2 + 2.5
	return math.abs(lp.X) <= sx and math.abs(lp.Z) <= sz and lp.Y >= -3 and lp.Y <= b.Size.Y / 2 + 10
end

local function askTreadmill()
	local rf = remote("RF/Treadmill/AskWearStill")
	if not rf or not rf:IsA("RemoteFunction") then return false, nil end
	local ok, res = pcall(function() return rf:InvokeServer() end)
	return ok, res
end

local function teleportToBelt(targetPos)
	local r = root()
	if not r then return false end
	local char = localPlayer.Character
	if not char then return false end
	local h = char:FindFirstChildOfClass("Humanoid")
	if h then h.PlatformStand = false h.Sit = false end
	pcall(function()
		r.CFrame = CFrame.new(targetPos) * CFrame.Angles(0, math.rad(90), 0)
		r.AssemblyLinearVelocity = Vector3.zero
		r.AssemblyAngularVelocity = Vector3.zero
	end)
	task.wait(0.15)
	local r2 = root()
	if not r2 then return false end
	return (r2.Position - targetPos).Magnitude <= 5
end

local function treadmillLoop()
	local tk = TREAD.Token
	while TREAD.Running and tk == TREAD.Token do
		if not state.Busy and not state.Carrying then
			if not onBelt() then
				if os.clock() >= TREAD.NextTry then
					local b = beltPart()
					if b then
						local tg = b.Position + Vector3.new(0, b.Size.Y / 2 + 4, 0)
						local arrived = false
						for _ = 1, 3 do
							if not TREAD.Running then break end
							if teleportToBelt(tg) then arrived = true break end
							task.wait(0.3)
						end
						if arrived then
							task.wait(0.15)
							if not onBelt() then teleportToBelt(tg) task.wait(0.15) end
							if onBelt() then
								local h = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
								if h then h.Sit = false h.PlatformStand = false end
								local ok, res = askTreadmill()
								TREAD.Riding = ok and res ~= false
								TREAD.NextTry = os.clock() + (TREAD.Riding and 30 or 2)
							else TREAD.NextTry = os.clock() + 1 end
						else TREAD.NextTry = os.clock() + 1 end
					else TREAD.NextTry = os.clock() + 2 end
				end
			else
				if TREAD.Riding and os.clock() >= (TREAD.NextTry or 0) then
					TREAD.NextTry = os.clock() + 15
					task.spawn(function()
						local ok, res = askTreadmill()
						if TREAD.Running then TREAD.Riding = ok and res == true end
					end)
				end
			end
		end
		task.wait(0.4)
	end
end

local function treadWatcher()
	if TREAD.WatcherConn then return end
	TREAD.WatcherConn = RunService.Heartbeat:Connect(function()
		if not TREAD.Running then return end
		if TREAD.Riding and not onBelt() then
			TREAD.Riding = false
			TREAD.NextTry = 0
		end
	end)
end

local function stopTreadWatcher()
	if TREAD.WatcherConn then TREAD.WatcherConn:Disconnect() TREAD.WatcherConn = nil end
end

local function startTreadmill()
	if TREAD.Running then return end
	TREAD.Running = true
	TREAD.Riding = false
	TREAD.NextTry = 0
	TREAD.Token += 1
	treadWatcher()
	task.spawn(treadmillLoop)
end

local function stopTreadmill()
	TREAD.Running = false
	TREAD.Token += 1
	TREAD.Riding = false
	TREAD.NextTry = 0
	stopTreadWatcher()
	local rf = remote("RF/Treadmill/AskDoff")
	if rf and rf:IsA("RemoteFunction") then pcall(function() rf:InvokeServer() end) end
end

-- ============================================================
-- LOOP
-- ============================================================
local LOOP = { On = false }

local function loopRun()
	while LOOP.On do
		if state.Busy or state.Carrying then
			task.wait(1)
		else
			local hasEgg = false
			for _, r in ipairs(snapshot()) do
				local info = describe(r)
				if passFilter(info) then hasEgg = true break end
			end
			if hasEgg then
				if not AUTO.Running then
					stopTreadmill()
					startAuto()
					status("Loop: roubando")
				end
			else
				if AUTO.Running then stopAuto() task.wait(0.5) end
				if not TREAD.Running then
					startTreadmill()
					status("Loop: esteira")
				end
			end
			task.wait(1.5)
		end
	end
end

local function startLoop()
	if LOOP.On then return end
	if FILTER.Mode == "Off" then return false end
	LOOP.On = true
	task.spawn(loopRun)
	return true
end

local function stopLoop()
	LOOP.On = false
	if AUTO.Running then stopAuto() end
	if TREAD.Running then stopTreadmill() end
end

