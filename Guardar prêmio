	table.sort(infos, function(a, b)
		if a.Value ~= b.Value then return a.Value > b.Value end
		return a.Rarity > b.Rarity
	end)
	local best = infos[1]
	makeESP()
	ESP.Billboard.Enabled = true
	ESP.Host.CFrame = CFrame.new(best.CFrame.Position + Vector3.new(0, 3, 0))
	local iconUrl = best.PetIcon
	if iconUrl == "" then iconUrl = best.EggIcon end
	if iconUrl ~= "" then
		ESP.Icon.Visible = true
		ESP.Icon.Image = iconUrl
	else ESP.Icon.Visible = false end
	local r = root()
	local dist = r and (r.Position - best.CFrame.Position).Magnitude or 0
	ESP.Name.Text = best.Name
	ESP.Rarity.Text = "[" .. FILTER.RarityNames[best.Rarity + 1]:gsub("%+$", "") .. "] "
		.. formatVal(best.Value) .. " • " .. formatDist(dist)
end

