-- BASE SCANNER
-- ============================================================
local BASE_SCAN = { Last = nil, At = 0 }
local function scanBase()
	if os.clock() - BASE_SCAN.At < 2 and BASE_SCAN.Last then
		return BASE_SCAN.Last
	end
	BASE_SCAN.At = os.clock()
	local inv = readInventory()
	local total = 0
	local count = 0
	local list = {}
	for uid, rec in pairs(inv) do
		if rec.Placement ~= nil then
			local info = describeRecord(tostring(rec.AssetCategory or ""), rec)
			info.Uid = uid
			total += info.Value or 0
			count += 1
			list[#list + 1] = info
		end
	end
	table.sort(list, function(a, b)
		if (a.Value or 0) ~= (b.Value or 0) then
			return (a.Value or 0) > (b.Value or 0)
		end
		return a.Name < b.Name
	end)
	local result = { Total = total, Count = count, List = list }
	BASE_SCAN.Last = result
	return result
end

