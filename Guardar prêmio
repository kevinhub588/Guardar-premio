local function runToEgg(uid, egg)
	local lineX = lineInfo()
	local home = homePoint()
	local ch = localPlayer.Character
	local h = ch and ch:FindFirstChildOfClass("Humanoid")
	if h then
		h.PlatformStand = false
		if ch:FindFirstChildWhichIsA("Tool") then pcall(function() h:UnequipTools() end) end
	end
	local r = root()
	if not r then return false end
	local stage = "field"
	if r.Position.X < lineX - 2
		and Vector3.new(r.Position.X - home.X, 0, r.Position.Z - home.Z).Magnitude > 20 then
		stage = "safe"
	end
	local st, lc, lp, lt = os.clock(), os.clock(), r.Position, 0
	while os.clock() - st < 120 and not state.Cancel do
		r = root()
		if not r then return false end
		local fe = Vector3.new(egg.X - r.Position.X, 0, egg.Z - r.Position.Z)
		if stage == "field" and fe.Magnitude <= 2.5 then break end
		local tgt = egg
		if stage == "safe" then
			if Vector3.new(home.X - r.Position.X, 0, home.Z - r.Position.Z).Magnitude <= 6 then
				stage = "field"
			else tgt = home end
		end
		local wp = avoid(r.Position, tgt)
		local fl = Vector3.new(wp.X - r.Position.X, 0, wp.Z - r.Position.Z)
		local u = fl.Magnitude > 0.01 and fl.Unit or Vector3.zero
		local sp = math.max(walkSpeed() * CFG.SpeedCap, 8)
		local v = u * math.min(sp, fl.Magnitude / 0.05)
		pcall(function()
			r.AssemblyLinearVelocity = Vector3.new(v.X, r.AssemblyLinearVelocity.Y, v.Z)
			if h and u.Magnitude > 0 then h:Move(u, false) end
		end)
		if os.clock() - lc >= 1.5 then
			if (r.Position - lp).Magnitude < 3 and h and fe.Magnitude > 15 then
				pcall(function() h.Jump = true end)
			end
			lp, lc = r.Position, os.clock()
		end
		if stage == "field" and fe.Magnitude <= 9 and os.clock() - lt > 0.1 then
			lt = os.clock()
			takeEgg(uid)
		end
		RunService.Heartbeat:Wait()
	end
	r = root()
	if r then
		pcall(function()
			r.AssemblyLinearVelocity = Vector3.new(0, r.AssemblyLinearVelocity.Y, 0)
			if h then h:Move(Vector3.zero, false) end
		end)
	end
	return state.Carrying or (r ~= nil
		and Vector3.new(egg.X - r.Position.X, 0, egg.Z - r.Position.Z).Magnitude <= 6)
end

local function eggNow(uid, cache)
	local n = workspace:FindFirstChild(uid)
	local s = workspace:FindFirstChild("AreaEggSlotsClient")
	n = n or (s and s:FindFirstChild(uid))
	if n then
		local ok, p = pcall(function() return n:GetPivot().Position end)
		if ok and p then cache.Pos, cache.At = p, os.clock() return p end
	end
	if os.clock() - cache.At >= 0.5 then
		cache.At = os.clock()
		cache.Pos = eggPosition(uid) or cache.Pos
	end
	return cache.Pos
end

local function grab(uid, timeout)
	local cache = { At = 0 }
	local w, s = 0, 1
	while not state.Carrying and w < timeout and not state.Cancel do
		local r = root()
		local e = eggNow(uid, cache)
		local dt = math.max(RunService.Heartbeat:Wait(), 1 / 240)
		w += dt
		s += dt
		if r and e then
			local d = e - r.Position
			if d.Magnitude > 2 then
				local pc = math.max(walkSpeed() * CFG.SpeedCap, 16)
				local v = d / math.max(0.08, dt)
				if v.Magnitude > pc then v = v.Unit * pc end
				pcall(function()
					r.AssemblyLinearVelocity = v + Vector3.new(0, workspace.Gravity * dt * 0.5, 0)
					r.AssemblyAngularVelocity = Vector3.zero
				end)
			end
			if s >= CFG.GrabInterval then
				s = 0
				local p = promptNear(e - Vector3.new(0, 3, 0), 10)
				if p and typeof(fireproximityprompt) == "function" then
					pcall(function() p.HoldDuration = 0 end)
					pcall(fireproximityprompt, p)
				end
				task.spawn(takeEgg, uid)
			end
		elseif s >= CFG.GrabInterval then
			s = 0
			task.spawn(takeEgg, uid)
		end
	end
	local r = root()
	if r then pcall(function() r.AssemblyLinearVelocity = Vector3.zero end) end
	return state.Carrying and state.Uid == uid
end

local function regrab(uid)
	if state.Carrying then return true end
	local r = root()
	local e = eggPosition(uid)
	if r and e and Vector3.new(r.Position.X - e.X, 0, r.Position.Z - e.Z).Magnitude > CFG.Regfar then
		status("Ovo caiu longe, teleportando")
		place(e + Vector3.new(0, 3, 0))
	else
		status("Ovo caiu perto")
	end
	return grab(uid, 3)
end

local function groundY(pos, fb)
	local y = fb
	pcall(function()
		local pr = RaycastParams.new()
		pr.FilterType = Enum.RaycastFilterType.Exclude
		pr.FilterDescendantsInstances = { localPlayer.Character }
		pr.IgnoreWater = true
		local hit = workspace:Raycast(pos + Vector3.new(0, 60, 0), Vector3.new(0, -140, 0), pr)
		if hit and hit.Material ~= Enum.Material.Water and math.abs(hit.Position.Y - fb) < 40 then
			y = hit.Position.Y + 3.5
		end
	end)
	return y
end

local function carrySpeed(dist)
	local ws = walkSpeed()
	local base = ws * math.min(CFG.CarryRatio, CFG.SpeedCap) * state.Mult
	local fast = base * 1.5
	local excess = 5.5 * base
	local lim = fast
	if dist and dist > excess then
		lim = math.min(fast, base * dist / (dist - excess))
	end
	return math.min(
		math.max(math.min(base * CFG.EasyRatio, lim), base),
		math.max(ws * CFG.SpeedCap, base)
	)
end

local function runHome(lineX, laneZ)
	local st = os.clock()
	local home = homePoint()
	local ck = lineX - 7
	local ht = CFG.Height
	local sh = math.clamp(CFG.ClimbShare, 0.1, 0.9)
	local ds = ht * math.sqrt(1 - sh * sh) / sh
	local ch = localPlayer.Character
	local h = ch and ch:FindFirstChildOfClass("Humanoid")
	if h then h.PlatformStand = false end
	local r = root()
	if r and ch and ht > 0.5 and home.Y + ht - 2 > r.Position.Y then
		pcall(function()
			ch:PivotTo(CFrame.new(Vector3.new(r.Position.X, home.Y + ht, r.Position.Z)) * r.CFrame.Rotation)
			r.AssemblyLinearVelocity = Vector3.zero
			r.AssemblyAngularVelocity = Vector3.zero
		end)
	end
	local s0 = root()
	local sp = carrySpeed(s0 and (Vector3.new(s0.Position.X - home.X, 0, s0.Position.Z - home.Z).Magnitude + math.max(0, ht) * 2) or nil)
	local lst = os.clock()
	local to = 0
	status("Zona segura")
	while state.Carrying and state.Delivered < st and not state.Cancel and to < 25 do
		r = root()
		if not r then return false end
		local nw = os.clock()
		local dt = math.max(nw - lst, 1 / 240)
		lst = nw
		to += dt
		local tH = r.Position.X <= ck + 2
		local tg = tH and home or Vector3.new(ck, home.Y, laneZ)
		if tH and Vector3.new(home.X - r.Position.X, 0, home.Z - r.Position.Z).Magnitude < 2 then break end
		local am = avoid(r.Position, tg)
		local fl = Vector3.new(am.X - r.Position.X, 0, am.Z - r.Position.Z)
		local rm = tH and 0 or math.max(0, r.Position.X - ck)
		local wY = home.Y + ht
		if tH or rm <= ds then wY = home.Y + ht * math.clamp(rm / math.max(ds, 1), 0, 1) end
		local vy = math.clamp((wY - r.Position.Y) / 0.12, -sp * sh, sp * sh)
		local hz = math.sqrt(math.max(sp * sp - vy * vy, 0))
		local v = fl.Magnitude > 0.01 and fl.Unit * math.min(hz, fl.Magnitude / 0.05) or Vector3.zero
		pcall(function() r.AssemblyLinearVelocity = Vector3.new(v.X, vy, v.Z) end)
		RunService.Heartbeat:Wait()
	end
	if h then pcall(function() h:Move(Vector3.zero, false) end) end
	local se = 0
	while se < 2 and state.Delivered < st and state.Carrying and not state.Cancel do
		se += RunService.Heartbeat:Wait()
	end
	if state.Carrying and state.Delivered < st and not state.Cancel then
		task.wait(0.2)
		dropEgg()
		local w = 0
		while state.Delivered < st and w < 1 do w += RunService.Heartbeat:Wait() end
	end
	return state.Delivered >= st
end

